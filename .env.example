# Token che la PWA deve inviare come "Authorization: Bearer <token>".
# Generane uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANKI_API_TOKEN=cambia-questo-token

# Cartella dove vivono collection.anki2, la cartella media e le credenziali di sync.
ANKI_DATA_DIR=/data

# Origini da cui la PWA può chiamare l'API (separate da virgola). Vuoto = solo stessa origine (consigliato).
ANKI_CORS_ORIGINS=

# Sync automatica con AnkiWeb ogni N minuti (0 = disattivata).
ANKI_AUTO_SYNC_MINUTES=10

# Server di sync: vuoto = AnkiWeb. Per un server self-hosted (anche quello incluso
# nel pacchetto anki: python -m anki.syncserver) es. http://anki-sync:8080/
# Se lo cambi dopo il login, la chiave salvata non vale più: rifai il login dalla PWA.
ANKI_SYNC_ENDPOINT=

# Log: json (una riga per evento, default nel container) oppure text.
# ANKI_LOG_FORMAT=json

# Limiti ai tentativi sbagliati, per IP: token dell'API e login AnkiWeb.
# ANKI_TOKEN_MAX_FAILURES=20
# ANKI_TOKEN_WINDOW_S=600
# ANKI_LOGIN_MAX_FAILURES=5
# ANKI_LOGIN_WINDOW_S=900

# Facoltativo: login automatico al primo avvio. Dopo il primo login
# il backend salva solo la chiave di sessione (hkey) e queste possono essere tolte.
# ANKIWEB_USERNAME=
# ANKIWEB_PASSWORD=
