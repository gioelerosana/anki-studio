# Accesso con Authentik (OIDC). La PWA non chiede nessun token: il backend fa il login
# su Authentik e tiene la sessione in un cookie HttpOnly. Sul provider Authentik la
# redirect URI è <ANKI_PUBLIC_URL>/api/auth/callback (vedi deploy/stack/README.md).
ANKI_PUBLIC_URL=https://anki.jshep.xyz
ANKI_OIDC_ISSUER=https://auth.jshep.xyz/application/o/anki-studio/
ANKI_OIDC_CLIENT_ID=anki-studio
ANKI_OIDC_CLIENT_SECRET=
# In alternativa (Docker secret, come nello stack): il file che contiene il client secret.
# ANKI_OIDC_CLIENT_SECRET_FILE=/run/secrets/anki_oidc_client_secret
# Seconda barriera dopo le policy di Authentik (virgole): utenti o gruppi ammessi.
# ANKI_OIDC_ALLOWED_GROUPS=authentik Admins
# ANKI_SESSION_DAYS=30

# Solo sviluppo, senza Authentik (rifiutato se il processo serve anche la PWA):
# ANKI_DEV_LOGIN=true

# Facoltativo, solo per script e curl ("Authorization: Bearer <token>"): la PWA non lo usa.
# Generane uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ANKI_API_TOKEN=
# ANKI_API_TOKEN_FILE=/run/secrets/anki_api_token

# Cartella dove vivono collection.anki2, la cartella media e le credenziali di sync.
ANKI_DATA_DIR=/data

# Origini da cui la PWA può chiamare l'API (separate da virgola). Vuoto = solo stessa origine (consigliato).
ANKI_CORS_ORIGINS=

# Sync automatica con AnkiWeb ogni N minuti (0 = disattivata).
ANKI_AUTO_SYNC_MINUTES=10

# Dopo una scrittura da un agente (token `ask_…`) o dalle rotte hub, la sync con AnkiWeb parte da
# sola dopo questi secondi, con più scritture raggruppate in una sola sync (0 = spenta).
# ANKI_SYNC_AFTER_WRITE_SECONDS=30

# Server di sync: vuoto = AnkiWeb. Per un server self-hosted (anche quello incluso
# nel pacchetto anki: python -m anki.syncserver) es. http://anki-sync:8080/
# Se lo cambi dopo il login, la chiave salvata non vale più: rifai il login dalla PWA.
ANKI_SYNC_ENDPOINT=

# Log: json (una riga per evento, default nel container) oppure text.
# ANKI_LOG_FORMAT=json

# Limiti ai tentativi sbagliati, per IP: token o login OIDC non validi e login AnkiWeb.
# ANKI_TOKEN_MAX_FAILURES=20
# ANKI_TOKEN_WINDOW_S=600
# ANKI_LOGIN_MAX_FAILURES=5
# ANKI_LOGIN_WINDOW_S=900

# Facoltativo: login automatico al primo avvio. Dopo il primo login
# il backend salva solo la chiave di sessione (hkey) e queste possono essere tolte.
# ANKIWEB_USERNAME=
# ANKIWEB_PASSWORD=
